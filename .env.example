# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Optional - provides cloud persistence)
# When not supplied, CampusNotes automatically runs with high-fidelity client-side persistent storage
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="campusnotes-academic.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="campusnotes-academic"
VITE_FIREBASE_STORAGE_BUCKET="campusnotes-academic.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
